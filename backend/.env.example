# ─── Server ───────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────
DATABASE_URL=postgresql://scheduler:scheduler_secret@localhost:5432/email_scheduler

# ─── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── Google OAuth ─────────────────────────────────────
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ─── Slack OAuth ──────────────────────────────────────
# Create a Slack app at: https://api.slack.com/apps
# Required scopes: chat:write, incoming-webhook
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ─── Elasticsearch ────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=email_jobs

# ─── Live SMTP (Fallback to Ethereal if omitted) ──────
SMTP_HOST=HOST
SMTP_PORT=PORT
SMTP_USER=Ethereal_MAIL
SMTP_PASS=Ethereal_password
Security=Security

# ─── BullMQ / Worker Settings ────────────────────────
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000

# ─── Rate Limiting ────────────────────────────────────
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# ─── Bull Board (Queue Dashboard) ─────────────────────
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin123
